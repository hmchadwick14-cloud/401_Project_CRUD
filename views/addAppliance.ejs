
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add Appliance</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container py-5" style="max-width: 680px">
    <h1 class="mb-4">Add a new appliance</h1>

    <form action="/addAppliance" method="POST" class="card card-body shadow-sm">
      <label class="form-label" for="name">Name *</label>
      <input class="form-control mb-3" id="name" name="name" type="text" required>

      <label class="form-label" for="type">Type *</label>
      <input class="form-control mb-3" id="type" name="type" type="text" required>

      <label class="form-label" for="brand">Brand</label>
      <input class="form-control mb-3" id="brand" name="brand" type="text">

      <label class="form-label" for="model">Model</label>
      <input class="form-control mb-3" id="model" name="model" type="text">

      <label class="form-label" for="category">Category *</label>
      <input class="form-control mb-3" id="category" name="category" type="text" required>

      <label class="form-label" for="purchase_date">Purchase Date</label>
      <input class="form-control mb-3" id="purchase_date" name="purchase_date" type="date">

      <label class="form-label" for="last_maintenance_date">Last Maintenance Date</label>
      <input class="form-control mb-3" id="last_maintenance_date" name="last_maintenance_date" type="date">

      <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Create appliance</button>
        <button class="btn btn-outline-secondary" type="reset">Clear</button>
        <a class="btn btn-link" href="/appliances">Back to appliances</a>
      </div>
    </form>
  </main>
</body>
</html>
