<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Log in | HomeBase</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { min-height: 100vh; background: #f4f7f5; }
    .login-layout { display: flex; align-items: center; gap: 20px; }
    .login-card { width: 440px; border: 1px solid #dddddd; border-radius: 8px; background: white; }
    .house-card { width: 300px; border: 1px solid #dddddd; border-radius: 8px; background: white; padding: 10px; }
    .house-image { width: 100%; height: 190px; object-fit: cover; border: 1px solid #cccccc; border-radius: 4px; }
    .brand-mark { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: #dff3e9; color: #176b4d; font-size: 1.35rem; }
    .form-control { padding: .75rem .9rem; }
    .btn-primary { background: #176b4d; border-color: #176b4d; padding: .75rem; }
    .btn-primary:hover { background: #12583f; border-color: #12583f; }
    @media (max-width: 800px) {
      .login-layout { flex-direction: column; }
      .house-card { width: 440px; }
      .login-card { width: 440px; max-width: 100%; }
    }
  </style>
</head>
<body class="d-flex align-items-center justify-content-center p-3">
  <main class="login-layout">
    <div class="house-card">
      <img class="house-image" src="/house.svg" alt="A house">
    </div>
    <div class="login-card shadow-sm">
      <div class="card-body p-4 p-md-5">
        <div class="brand-mark mb-4" aria-hidden="true">⌂</div>
        <p class="text-uppercase small fw-semibold text-success mb-2">HomeBase</p>
        <h1 class="h3 fw-bold mb-2">Welcome back</h1>
        <p class="text-secondary mb-4">Enter your username and associated email to continue.</p>

        <% if (error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>

        <form action="/login" method="post">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input class="form-control" id="username" name="username" autocomplete="username" required autofocus>
          </div>
          <div class="mb-4">
            <label for="email" class="form-label">Email</label>
            <input class="form-control" type="email" id="email" name="email" autocomplete="email" required>
          </div>
          <button class="btn btn-primary w-100" type="submit">Log in</button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>
