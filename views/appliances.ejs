
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Maintain Appliances</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="mb-1">Maintain Appliances</h1>
        <p class="text-secondary mb-0">Supabase table: <code>public.appliances</code></p>
      </div>
      <a class="btn btn-primary" href="/addAppliance">Add an appliance</a>
    </div>

    <div class="table-responsive bg-white rounded shadow-sm">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Type</th>
            <th>Brand</th>
            <th>Model</th>
            <th>Category</th>
            <th>Purchase Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (appliances.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center text-secondary py-4">No appliances found.</td>
            </tr>
          <% } %>

          <% appliances.forEach(item => { %>
            <tr>
              <td><%= item.appliance_id %></td>
              <td><%= item.name %></td>
              <td><%= item.type %></td>
              <td><%= item.brand || '—' %></td>
              <td><%= item.model || '—' %></td>
              <td><%= item.category %></td>
              <td><%= item.purchase_date || '—' %></td>
              <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary"
                   href="/appliances/<%= encodeURIComponent(item.appliance_id) %>/edit">Edit</a>

                <form class="d-inline"
                      action="/appliances/<%= encodeURIComponent(item.appliance_id) %>/delete"
                      method="POST"
                      onsubmit="return confirm('Delete this appliance?')">
                  <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <a class="btn btn-link mt-3" href="/">Back to users</a>
  </main>
</body>
</html>
