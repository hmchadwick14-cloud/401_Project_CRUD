<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add User</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container py-5" style="max-width: 680px">
    <h1 class="mb-4">Add a new user</h1>
    <form id="addUserForm" action="/addUser" method="POST" class="card card-body shadow-sm">
      <p class="text-secondary">The database generates the user ID automatically.</p>
      <label class="form-label" for="username">Username</label>
      <input class="form-control mb-3" id="username" name="username" type="text" maxlength="255" required>
      <label class="form-label" for="email">Email</label>
      <input class="form-control mb-3" id="email" name="email" type="email" maxlength="255" required>
      <label class="form-label" for="password">Password</label>
      <input class="form-control mb-3" id="password" name="password" type="password" minlength="12" autocomplete="new-password" required>
      <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Create user</button><button class="btn btn-outline-secondary" type="reset">Clear</button><a class="btn btn-link" href="/">Back to users</a></div>
    </form>
  </main>
</body>
</html>
