
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit Appliance</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container py-5" style="max-width: 680px">
    <h1 class="mb-4">Edit appliance</h1>

    <form action="/appliances/<%= encodeURIComponent(item.appliance_id) %>/edit"
          method="POST" class="card card-body shadow-sm">

      <div class="mb-3">
        <span class="form-label d-block">Appliance ID</span>
        <code><%= item.appliance_id %></code>
      </div>

      <label class="form-label" for="name">Name *</label>
      <input class="form-control mb-3" id="name" name="name"
             type="text" value="<%= item.name %>" required>

      <label class="form-label" for="type">Type *</label>
      <input class="form-control mb-3" id="type" name="type"
             type="text" value="<%= item.type %>" required>

      <label class="form-label" for="brand">Brand</label>
      <input class="form-control mb-3" id="brand" name="brand"
             type="text" value="<%= item.brand || '' %>">

      <label class="form-label" for="model">Model</label>
      <input class="form-control mb-3" id="model" name="model"
             type="text" value="<%= item.model || '' %>">

      <label class="form-label" for="category">Category *</label>
      <input class="form-control mb-3" id="category" name="category"
             type="text" value="<%= item.category %>" required>

      <label class="form-label" for="purchase_date">Purchase Date</label>
      <input class="form-control mb-3" id="purchase_date"
             name="purchase_date" type="date"
             value="<%= item.purchase_date || '' %>">

      <label class="form-label" for="last_maintenance_date">Last Maintenance Date</label>
      <input class="form-control mb-3" id="last_maintenance_date"
             name="last_maintenance_date" type="date"
             value="<%= item.last_maintenance_date || '' %>">

      <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Save changes</button>
        <a class="btn btn-outline-secondary" href="/appliances">Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
