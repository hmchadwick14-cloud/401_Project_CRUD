<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>User Management System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div><h1 class="mb-1">Users</h1><p class="text-secondary mb-0">Supabase table: <code>public.admin_users</code></p></div>
      <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="/appliances">Maintain Appliances</a>
        <a class="btn btn-primary" href="/addUser">Add a user</a>
      </div>
    </div>
    <div class="table-responsive bg-white rounded shadow-sm">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark"><tr><th>ID</th><th>Username</th><th>Email</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (users.length === 0) { %>
            <tr><td colspan="4" class="text-center text-secondary py-4">No users found.</td></tr>
          <% } %>
          <% users.forEach(item => { %>
            <tr>
              <td><code><%= item.user_id %></code></td>
              <td><%= item.username || '—' %></td>
              <td><%= item.email || '—' %></td>
              <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" href="/index/<%= encodeURIComponent(item.user_id) %>/edit">Edit</a>
                <form class="d-inline" action="/index/<%= encodeURIComponent(item.user_id) %>/delete" method="POST" onsubmit="return confirm('Delete this user?')">
                  <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
